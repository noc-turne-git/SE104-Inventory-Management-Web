FROM node:20-alpine

WORKDIR /app

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Copy package files first to maximize layer cache
COPY package*.json ./
RUN npm install

# Copy application source
COPY . .

# Build the frontend with the API URL baked in
RUN npm run build

# Install a tiny static server
RUN npm install -g serve

# Serve the built SPA on port 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
