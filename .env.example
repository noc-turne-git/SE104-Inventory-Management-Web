# App runtime
PORT=5074

# Database (normalized fields)
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=TESTQLK
CONNECTION_STRING=Host=db;Port=5432;Database=TESTQLK;Username=postgres;Password=your_db_password;

# Backend API (.NET expected keys)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=TESTQLK;Username=postgres;Password=your_db_password
ConnectionStrings__HangfireConnection=Host=db;Port=5432;Database=TESTQLK;Username=postgres;Password=your_db_password
Hangfire__Enabled=true
Redis__ConnectionString=redis:6379
Jwt__Key=replace_with_a_strong_secret_key
Jwt__Issuer=BackendAPI
Jwt__Audience=Frontend
Email__DisplayName=Stockify
Email__FromAddress=stockify.support@gmail.com
