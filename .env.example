Email__SmtpPort=587
Email__Username=stockify.support@gmail.com
Email__Password=replace_with_email_app_password
Email__UseStartTls=true
Frontend__VerifyEmailUrl=http://3.106.211.154:5173/verify-email

# Docker/Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
